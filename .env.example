# ---- Required ----
# Postgres. On Supabase: Project Settings > Database > Connection string.
# DATABASE_URL = pooled connection (port 6543, add ?pgbouncer=true&connection_limit=1)
# DIRECT_URL   = direct connection (port 5432), used for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Random 32+ character secret for signing sessions:  openssl rand -base64 32
NEXTAUTH_SECRET=""
# The public URL of the app, e.g. https://skyland.example.com
NEXTAUTH_URL="http://localhost:3000"

# ---- Claude (owner chat, board reports, reminders) ----
# Without it the app uses built-in templates and keyword replies.
ANTHROPIC_API_KEY=""
# Optional model override (default claude-opus-5-5)
ANTHROPIC_MODEL=""

# ---- Online payments: PayMongo (GCash, Maya, cards) ----
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
# With no PayMongo key, set to 1 to allow simulated "test mode" payments (demos only)
ALLOW_TEST_PAYMENTS=""

# ---- SMS reminders: Semaphore ----
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER=""

# ---- Demo helpers ----
# Shows one-click demo logins on the sign-in page. Turn OFF for real residents.
NEXT_PUBLIC_SHOW_DEMO_LOGINS=""
# Password for the seeded accounts (default Skyland2026!)
SEED_PASSWORD=""
# Manager's monthly base salary for the bonus scorecard (default 70000)
MANAGER_BASE_SALARY=""

# Optional: Google photorealistic 3D look on /green/map. Create a key in Google Cloud with the
# Map Tiles API enabled and billing on, restrict it to your domain, then set it here.
# Without it the 3D map uses free Sentinel-2 satellite imagery.
GOOGLE_MAPS_API_KEY=""
