// Building Mgt AI - data model
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  BOARD
  MANAGER
  ADMIN
  GUARD
  INVESTOR // demo/read-only: business snapshot
  LANDLORD // shown as "Building owner": read-only whole-building view
  CLIENT // demo/read-only: a prospect's own sustainability demo (site picked by email, see lib/green.ts)
}

enum WOStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  ESCALATED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum BillStatus {
  UNPAID
  PARTIAL
  PAID
}

model Building {
  id        String   @id @default(cuid())
  name      String
  city      String
  duesRate  Decimal  @db.Decimal(10, 2) // PHP per sqm per month
  units     Unit[]
  users     User[]
  createdAt DateTime @default(now())
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  phone           String?
  passwordHash    String
  role            Role             @default(OWNER)
  active          Boolean          @default(true)
  buildingId      String
  building        Building         @relation(fields: [buildingId], references: [id])
  units           Unit[]           @relation("UnitOwner")
  workOrders      WorkOrder[]      @relation("WOReporter")
  chat            ChatMessage[]
  bookings        Booking[]
  audit           AuditLog[]
  language        String           @default("EN") // EN | TL (Taglish)
  notifySms       Boolean          @default(true)
  notifyEmail     Boolean          @default(true)
  notifyMessenger Boolean          @default(false)
  messengerPsid   String? // Page-scoped ID, set when the owner links Messenger
  viberId         String? // Viber user id, set when the owner links Viber
  deliveries      Delivery[]
  passes          Pass[]
  amenityBookings AmenityBooking[]
  votes           Vote[]
  pulses          Pulse[]
  listings        Listing[]
  moves           MoveRequest[]
  registrations   Registration[]
  marketItems     MarketItem[]
  lostFound       LostFound[]
  sosAlerts       SosAlert[]
  consentAt       DateTime? // when the person accepted the privacy notice
  loginCodes      LoginCode[]
  privacyRequests PrivacyRequest[]
  rounds          GuardRound[]
  createdAt       DateTime         @default(now())
}

model Unit {
  id              String           @id @default(cuid())
  code            String // e.g. 12B
  floor           Int
  sqm             Decimal          @db.Decimal(8, 2)
  buildingId      String
  building        Building         @relation(fields: [buildingId], references: [id])
  ownerId         String?
  owner           User?            @relation("UnitOwner", fields: [ownerId], references: [id])
  ownerName       String? // for units whose owner has no login yet
  occupancy       String? // OWNER (owner lives here) | VACANT | null = not recorded; "leased" comes from a current Lease
  bills           Bill[]
  workOrders      WorkOrder[]
  bookings        Booking[]
  passes          Pass[]
  amenityBookings AmenityBooking[]
  votes           Vote[]
  listings        Listing[]
  leases          Lease[]
  moves           MoveRequest[]
  utilities       UtilityReading[]
  registrations   Registration[]

  @@unique([buildingId, code])
}

model WorkOrder {
  id           String      @id @default(cuid())
  number       Int         @unique @default(autoincrement())
  unitId       String?
  unit         Unit?       @relation(fields: [unitId], references: [id])
  location     String // unit code or common area
  title        String
  description  String?
  category     String
  priority     Priority    @default(MEDIUM)
  status       WOStatus    @default(NEW)
  slaHours     Int
  assignee     String?
  source       String      @default("Portal")
  reporterId   String?
  reporter     User?       @relation("WOReporter", fields: [reporterId], references: [id])
  createdAt    DateTime    @default(now())
  closedAt     DateTime?
  rating       Int?
  photo        String? // resident photo as a compressed JPEG data URL (photo-to-ticket)
  aiNote       String? // what the AI saw in the photo and the advice it gave
  roundId      String? // set when a guard logged it during a round
  round        GuardRound? @relation(fields: [roundId], references: [id])
  events       WOEvent[]
  // Accountability: who acknowledged, who did the work (with photo proof) and who checked it.
  ackAt        DateTime? // first response by the manager or front desk
  ackBy        String?
  doneBy       String? // technician or vendor who did the work
  doneNote     String?
  donePhoto    String? // compressed JPEG data URL of the finished work (required to close)
  verifiedAt   DateTime? // manager confirmed the fix (within 24h of completion)
  verifiedBy   String?
  jobToken     String?     @unique // one-tap job link for technicians and vendors without an account
  photoSig     String? // fingerprint of the resident's photo: "sha:dhash" (filled lazily by lib/photosig)
  donePhotoSig String? // fingerprint of the after photo, used to spot reused or near-identical photos

  @@index([status])
}

model WOEvent {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  note        String
  author      String
  createdAt   DateTime  @default(now())
}

model Bill {
  id        String     @id @default(cuid())
  unitId    String
  unit      Unit       @relation(fields: [unitId], references: [id])
  period    String // YYYY-MM
  amount    Decimal    @db.Decimal(12, 2)
  paid      Decimal    @default(0) @db.Decimal(12, 2)
  dueDate   DateTime
  status    BillStatus @default(UNPAID)
  payments  Payment[]
  reminders Reminder[]
  createdAt DateTime   @default(now())

  @@unique([unitId, period])
  @@index([period, status])
}

model Payment {
  id        String   @id @default(cuid())
  billId    String
  bill      Bill     @relation(fields: [billId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  method    String // GCash, Maya, Bank, Cash, Card
  reference String
  createdAt DateTime @default(now())
}

model Reminder {
  id      String   @id @default(cuid())
  billId  String
  bill    Bill     @relation(fields: [billId], references: [id])
  channel String // Viber, SMS, Email
  tone    String
  message String
  sentBy  String
  sentAt  DateTime @default(now())
}

model BudgetLine {
  id       String  @id @default(cuid())
  period   String // YYYY-MM
  category String
  vendor   String
  budget   Decimal @db.Decimal(12, 2)
  actual   Decimal @db.Decimal(12, 2)
  note     String?

  @@unique([period, category])
}

model Report {
  id        String   @id @default(cuid())
  period    String
  content   String
  model     String
  createdBy String
  createdAt DateTime @default(now())
}

model Service {
  id        String    @id @default(cuid())
  name      String
  detail    String
  price     Decimal   @db.Decimal(10, 2)
  unitLabel String
  vendor    String
  active    Boolean   @default(true)
  bookings  Booking[]
}

model Booking {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  slot      DateTime
  qty       Int      @default(1)
  total     Decimal  @db.Decimal(10, 2)
  payMethod String
  status    String   @default("CONFIRMED")
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String // user | assistant
  content   String
  channel   String   @default("APP") // APP | MESSENGER | VIBER
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  detail    String?
  createdAt DateTime @default(now())
}

/**
 * ---------------- Resident communications ----------------
 */

enum AnnStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

model Announcement {
  id          String     @id @default(cuid())
  kind        String // URGENT | ROUTINE | REMINDER | TICKET
  category    String // e.g. Water interruption, Newsletter, Meeting notice
  title       String
  bodyEn      String
  bodyTl      String? // Taglish version
  smsEn       String? // short SMS version (<= 300 chars)
  smsTl       String?
  audience    String     @default("ALL") // ALL | FLOORS:12,13 | UNITS:12B,9C | OVERDUE | BOARD
  channels    String[]   @default(["APP", "SMS", "EMAIL"]) // APP SMS EMAIL MESSENGER
  status      AnnStatus  @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  aiDrafted   Boolean    @default(false)
  createdBy   String
  approvedBy  String?
  createdAt   DateTime   @default(now())
  deliveries  Delivery[]

  @@index([status, scheduledAt])
}

model Delivery {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  unitCode       String?
  channel        String // APP SMS EMAIL MESSENGER
  to             String?
  status         String // SENT | LOGGED | FAILED | READ
  info           String?
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([userId, channel])
}

/**
 * ---------------- Amenities ----------------
 */

model Amenity {
  id        String           @id @default(cuid())
  name      String
  detail    String
  capacity  Int
  fee       Decimal          @default(0) @db.Decimal(10, 2)
  openHour  Int // 0-23, Manila time
  closeHour Int
  slotHours Int              @default(1)
  closedDow Int? // 0=Sun..6=Sat
  rules     String?
  bookings  AmenityBooking[]
}

model AmenityBooking {
  id        String   @id @default(cuid())
  amenityId String
  amenity   Amenity  @relation(fields: [amenityId], references: [id])
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  start     DateTime
  end       DateTime
  guests    Int      @default(0)
  status    String   @default("CONFIRMED") // CONFIRMED | CANCELLED
  createdAt DateTime @default(now())

  @@index([amenityId, start])
}

/**
 * ---------------- Visitor and delivery passes ----------------
 */

model Pass {
  id         String    @id @default(cuid())
  code       String    @unique // 6-char code shown to the guard
  kind       String // GUEST | DELIVERY | CONTRACTOR | MOVE
  name       String // guest or courier name
  plate      String?
  unitId     String
  unit       Unit      @relation(fields: [unitId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  validFrom  DateTime
  validTo    DateTime
  checkedIn  DateTime?
  checkedOut DateTime?
  note       String?
  photo      String? // optional small guest photo (data URL) so the guard can match the face
  createdAt  DateTime  @default(now())
}

/**
 * ---------------- Documents ----------------
 */

model Document {
  id         String   @id @default(cuid())
  title      String
  category   String // Governance | Financial | Minutes | Contracts | Notices | Forms
  visibility String   @default("OWNERS") // OWNERS | BOARD
  fileName   String
  mime       String
  size       Int
  data       Bytes
  uploadedBy String
  createdAt  DateTime @default(now())
}

/**
 * ---------------- Voting and polls ----------------
 */

model Poll {
  id        String       @id @default(cuid())
  question  String
  detail    String?
  kind      String       @default("POLL") // POLL (one vote per owner) | RESOLUTION (one vote per unit, weighted by sqm)
  meetingId String? // AGM resolution: proxy holders for that meeting can vote for the units they hold
  closesAt  DateTime
  createdBy String
  createdAt DateTime     @default(now())
  options   PollOption[]
  votes     Vote[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label  String
  votes  Vote[]
}

model Vote {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit       @relation(fields: [unitId], references: [id])
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  weight    Decimal    @db.Decimal(10, 2)
  byProxy   Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@unique([pollId, unitId])
}

/**
 * ---------------- Vendors and contracts ----------------
 */

model Vendor {
  id              String    @id @default(cuid())
  name            String
  service         String
  contact         String?
  phone           String?
  email           String?
  monthlyValue    Decimal   @default(0) @db.Decimal(12, 2)
  contractStart   DateTime?
  contractEnd     DateTime?
  insuranceExpiry DateTime?
  rating          Decimal?  @db.Decimal(3, 1)
  notes           String?
  active          Boolean   @default(true)
}

/**
 * ---------------- Preventive maintenance ----------------
 */

model PMTask {
  id             String    @id @default(cuid())
  asset          String // e.g. Fire pump, Elevator 1-4, Genset
  task           String
  frequencyDays  Int
  lastDone       DateTime?
  nextDue        DateTime
  assignee       String?
  vendor         String?
  compliance     Boolean   @default(false) // required by BFP/DOLE/LGU
  lastWorkOrder  Int?
  assetTag       String? // registry asset this schedule covers
  /// Where the interval comes from. Safety-critical schedules must not stay UNVERIFIED.
  intervalSource String    @default("UNVERIFIED") // MANUFACTURER | STATUTORY | ENGINEER | CONTRACT | UNVERIFIED
}

/// Resident pulse: a 1-5 rating with an optional comment, after a repair (TICKET) or once a month (MONTHLY).
model Pulse {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  unitCode   String?
  kind       String // TICKET | MONTHLY | AMENITY
  score      Int // 1-5
  comment    String?
  topic      String? // Repairs, Elevators, Cleanliness, Security, Water, Communication, Amenities, Noise, Staff, Dues, Other
  sentiment  String? // POSITIVE | NEUTRAL | NEGATIVE
  workOrder  Int?
  followedUp DateTime?
  followNote String?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

// ---------- v3: resale & leasing, unit life, community, safety ----------
model Listing {
  id            String    @id @default(cuid())
  unitId        String
  unit          Unit      @relation(fields: [unitId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  kind          String // LEASE | SALE
  status        String    @default("DRAFT") // DRAFT | LIVE | RESERVED | CLOSED | WITHDRAWN
  price         Decimal   @db.Decimal(14, 2)
  suggestedLow  Decimal   @db.Decimal(14, 2)
  suggestedHigh Decimal   @db.Decimal(14, 2)
  beds          Int
  furnished     String // BARE | SEMI | FULL
  title         String
  body          String
  bodyTl        String?
  highlights    String[]
  rationale     String
  channels      String[] // FB_PAGE | FB_MARKETPLACE | FB_GROUPS
  posts         Json?
  views         Int       @default(0)
  publishedAt   DateTime?
  closedAt      DateTime?
  closedPrice   Decimal?  @db.Decimal(14, 2)
  broker        String?
  ai            Boolean   @default(false)
  inquiries     Inquiry[]
  createdAt     DateTime  @default(now())
}

model Inquiry {
  id        String    @id @default(cuid())
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name      String
  channel   String // MESSENGER | MARKETPLACE | GROUP | PAGE
  message   String
  aiReply   String?
  status    String    @default("NEW") // NEW | ANSWERED | VIEWING | OFFER | CLOSED
  viewingAt DateTime?
  passCode  String?
  createdAt DateTime  @default(now())
}

model MarketComp {
  id         String   @id @default(cuid())
  kind       String // LEASE | SALE
  source     String // SKYLAND_DEAL | SKYLAND_LISTING | NEARBY
  building   String
  distanceKm Float
  sqm        Decimal  @db.Decimal(8, 2)
  beds       Int
  floor      Int?
  furnished  String?
  price      Decimal  @db.Decimal(14, 2)
  date       DateTime
}

model Lease {
  id         String   @id @default(cuid())
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id])
  tenantName String
  rent       Decimal  @db.Decimal(12, 2)
  deposit    Decimal  @db.Decimal(12, 2)
  start      DateTime
  end        DateTime
  createdAt  DateTime @default(now())
}

model MoveRequest {
  id        String   @id @default(cuid())
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kind      String // MOVE_IN | MOVE_OUT | RENOVATION
  date      DateTime
  done      String[] // checklist keys completed
  status    String   @default("PENDING") // PENDING | APPROVED | DONE
  passCode  String?
  note      String?
  createdAt DateTime @default(now())
}

model UtilityReading {
  id     String  @id @default(cuid())
  unitId String
  unit   Unit    @relation(fields: [unitId], references: [id])
  period String
  kind   String // WATER | ELECTRIC
  usage  Float
  amount Decimal @db.Decimal(10, 2)

  @@unique([unitId, period, kind])
}

model Registration {
  id        String   @id @default(cuid())
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kind      String // PET | VEHICLE
  name      String
  details   String
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  sticker   String?
  createdAt DateTime @default(now())
}

model MarketItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  category    String
  price       Decimal? @db.Decimal(12, 2)
  description String
  status      String   @default("ACTIVE") // ACTIVE | SOLD | REMOVED
  createdAt   DateTime @default(now())
}

model LostFound {
  id          String   @id @default(cuid())
  kind        String // LOST | FOUND
  title       String
  place       String
  description String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  status      String   @default("OPEN") // OPEN | RETURNED
  createdAt   DateTime @default(now())
}

model SosAlert {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  unitCode   String?
  kind       String // MEDICAL | FIRE | SECURITY | ELEVATOR | OTHER
  note       String?
  status     String    @default("OPEN") // OPEN | ACK | RESOLVED
  ackBy      String?
  ackAt      DateTime?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
}

/**
 * ---------------- Go-live: sign-in codes, rate limits, errors, privacy ----------------
 */

model LoginCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  channel   String // EMAIL | SMS
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

model ErrorLog {
  id        String   @id @default(cuid())
  source    String // server | client | api | cron | notify
  message   String
  detail    String?
  path      String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PrivacyRequest {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  kind      String // EXPORT | CORRECT | DELETE
  status    String    @default("OPEN") // OPEN | DONE | DECLINED
  note      String?
  reply     String?
  createdAt DateTime  @default(now())
  closedAt  DateTime?
}

/**
 * ---------------- Wow features, round 2 ----------------
 * userId / unitId here are plain ids (no relation) with the name or unit code copied in,
 * so these tables stay independent of the core models.
 */

/**
 * Board meetings and the AGM: AI-drafted agenda and minutes, plus action items.
 */
model Meeting {
  id        String       @id @default(cuid())
  title     String
  kind      String       @default("BOARD") // BOARD | AGM
  startsAt  DateTime
  place     String       @default("Function room, 5th floor")
  agenda    String? // markdown
  notes     String? // raw notes taken during the meeting
  minutes   String? // markdown, drafted from the notes
  status    String       @default("PLANNED") // PLANNED | HELD
  createdBy String
  createdAt DateTime     @default(now())
  actions   ActionItem[]
  proxies   Proxy[]
  attendees Attendance[]
}

model ActionItem {
  id        String    @id @default(cuid())
  meetingId String?
  meeting   Meeting?  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  text      String
  owner     String
  due       DateTime?
  status    String    @default("OPEN") // OPEN | DONE
  doneAt    DateTime?
  createdAt DateTime  @default(now())
}

/**
 * An owner names someone to vote for their unit at a meeting (usually the AGM).
 */
model Proxy {
  id           String    @id @default(cuid())
  meetingId    String
  meeting      Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  unitId       String
  unitCode     String
  grantorId    String
  holderUserId String? // set when the proxy holder has an account
  holderName   String
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@unique([meetingId, unitId])
}

/**
 * Units present at a meeting, for quorum.
 */
model Attendance {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  unitId    String
  unitCode  String
  via       String // IN_PERSON | ONLINE
  at        DateTime @default(now())

  @@unique([meetingId, unitId])
}

/**
 * Typhoon mode: one storm from prep alert to post-storm check-in.
 */
model StormEvent {
  id        String         @id @default(cuid())
  name      String
  phase     String         @default("PREP") // PREP | CHECKIN | CLOSED
  startedAt DateTime       @default(now())
  checkinAt DateTime?
  closedAt  DateTime?
  createdBy String
  checkins  StormCheckin[]
}

model StormCheckin {
  id        String     @id @default(cuid())
  stormId   String
  storm     StormEvent @relation(fields: [stormId], references: [id], onDelete: Cascade)
  unitId    String
  unitCode  String
  userId    String?
  status    String // OK | HELP | DAMAGE
  note      String?
  createdAt DateTime   @default(now())

  @@unique([stormId, unitId])
}

/**
 * Community feed: posts by group, staff kudos, and events with RSVPs.
 */
model Post {
  id         String     @id @default(cuid())
  userId     String
  authorName String
  unitCode   String?
  group      String     @default("General") // General | Pets | Sports | Parents | Kudos
  body       String
  staffName  String? // for kudos posts
  hidden     Boolean    @default(false)
  createdAt  DateTime   @default(now())
  likes      PostLike[]
}

model PostLike {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String

  @@unique([postId, userId])
}

model Event {
  id        String      @id @default(cuid())
  title     String
  detail    String?
  group     String      @default("General")
  startsAt  DateTime
  place     String
  createdBy String
  hostName  String
  createdAt DateTime    @default(now())
  rsvps     EventRsvp[]
}

model EventRsvp {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  name    String

  @@unique([eventId, userId])
}

/**
 * ---------------- Guard rounds and meter readings ----------------
 */

model GuardRound {
  id          String         @id @default(cuid())
  guardId     String
  guard       User           @relation(fields: [guardId], references: [id])
  shift       String // DAY | NIGHT
  startedAt   DateTime       @default(now())
  submittedAt DateTime?
  checked     String[] // checkpoint keys marked OK or with an issue
  notes       String?
  issues      WorkOrder[]
  readings    MeterReading[]

  @@index([startedAt])
}

model MeterReading {
  id      String      @id @default(cuid())
  meter   String // WATER_MAIN (m3) | ELECTRIC_MAIN (kWh) | GENSET_FUEL (%) | CISTERN (%)
  value   Float
  takenAt DateTime    @default(now())
  takenBy String
  roundId String?
  round   GuardRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@index([meter, takenAt])
}

/**
 * ---------------- Assets, stock and procurement ----------------
 */

model Asset {
  id              String          @id @default(cuid())
  tag             String          @unique // printed on the fixture, e.g. LT-B12-HALL-2
  name            String
  category        String // Lighting | Aircon | Pump | Elevator | Electrical | Plumbing | Safety | Fixture
  location        String // common area or unit code, same wording as work orders
  installedAt     DateTime
  lifeMonths      Int // expected life
  warrantyUntil   DateTime?
  cost            Decimal         @db.Decimal(12, 2)
  vendor          String?
  status          String          @default("OK") // OK | FAULTY | RETIRED
  // Registry fields (data readiness). Specs count as verified only when a person checked them against a source.
  manufacturer    String?
  model           String?
  serial          String?
  criticality     String          @default("NORMAL") // SAFETY | HIGH | NORMAL
  replacementCost Decimal?        @db.Decimal(12, 2)
  ownerName       String? // responsible person, e.g. chief engineer
  specSource      String? // NAMEPLATE | MANUAL | INVOICE | CONTRACTOR | UNKNOWN
  verifiedBy      String?
  verifiedAt      DateTime?
  manualDocId     String? // Document holding the manual or datasheet
  replacements    Replacement[]
  sensors         SensorReading[]
  createdAt       DateTime        @default(now())
}

model StockItem {
  id           String            @id @default(cuid())
  sku          String            @unique
  name         String
  category     String
  uom          String            @default("pc")
  onHand       Int               @default(0)
  reorderPoint Int
  reorderQty   Int
  benchmark    Decimal           @db.Decimal(12, 2) // fair unit price from recent market quotes
  lastPrice    Decimal?          @db.Decimal(12, 2)
  moves        StockMove[]
  replacements Replacement[]
  requests     PurchaseRequest[]
}

model StockMove {
  id        String    @id @default(cuid())
  itemId    String
  item      StockItem @relation(fields: [itemId], references: [id])
  qty       Int // + in, - out
  kind      String // RECEIVE | ISSUE | RETURN | ADJUST
  ref       String? // PO number, WO number or asset tag
  byName    String
  note      String?
  createdAt DateTime  @default(now())

  @@index([itemId, createdAt])
}

model Replacement {
  id              String     @id @default(cuid())
  assetId         String
  asset           Asset      @relation(fields: [assetId], references: [id])
  itemId          String?
  item            StockItem? @relation(fields: [itemId], references: [id])
  workOrder       Int?
  doneAt          DateTime
  doneBy          String // technician or vendor
  loggedBy        String // app user who recorded it
  cost            Decimal    @db.Decimal(12, 2) // what the building paid (0 when covered by warranty)
  warrantyClaim   Boolean    @default(false) // replaced free under the old part's warranty
  newWarrantyTil  DateTime?
  oldPartReturned Boolean    @default(false)
  photo           String? // compressed JPEG data URL of the new part installed
  note            String?
  createdAt       DateTime   @default(now())

  @@index([assetId, doneAt])
}

model PurchaseRequest {
  id           String     @id @default(cuid())
  number       Int        @unique @default(autoincrement())
  title        String
  category     String
  itemId       String?
  item         StockItem? @relation(fields: [itemId], references: [id])
  qty          Int        @default(1)
  reason       String
  workOrder    Int?
  status       String     @default("QUOTING") // QUOTING | PENDING | APPROVED | ORDERED | RECEIVED | PAID | REJECTED
  requestedBy  String // user id
  requester    String // display name
  approvals    Json       @default("[]") // [{ id, name, role, at }]
  rejectNote   String?
  chosenQuote  String?
  chooseNote   String? // why a quote other than the lowest was chosen
  poNumber     String?
  orderedAt    DateTime?
  receivedAt   DateTime?
  receivedBy   String?
  receivedQty  Int?
  receivedNote String?
  receivedPic  String?
  invoiceTotal Decimal?   @db.Decimal(12, 2)
  submittedAt  DateTime? // sent for approval; approvers have 48h
  receiptPic   String? // photo of the official receipt / sales invoice (no receipt, no payment)
  paidAt       DateTime?
  paidBy       String?
  paidRef      String? // check number or bank reference
  quotes       Quote[]
  createdAt    DateTime   @default(now())

  @@index([status])
}

model Quote {
  id        String          @id @default(cuid())
  requestId String
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendor    String
  total     Decimal         @db.Decimal(12, 2)
  leadDays  Int?
  note      String?
  addedBy   String
  createdAt DateTime        @default(now())
}

/**
 * IoT readings from elevator and genset sensors (vibration, door faults, battery, temperature, run hours).
 */
model SensorReading {
  id      String   @id @default(cuid())
  assetId String
  asset   Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  metric  String // VIBRATION (mm/s) | DOOR_FAULTS (per day) | BATTERY_V | COOLANT_C | RUN_HOURS | TRIPS (per day)
  value   Float
  at      DateTime @default(now())

  @@index([assetId, metric, at])
}

/**
 * Data-entry accountability: one row per reminder or escalation sent for an overdue record,
 * so the daily run never nags the same person twice for the same step.
 */
model DutyNudge {
  id     String   @id @default(cuid())
  key    String // task key, e.g. wo-ack:123
  level  Int // 1 reminder to the doer, 2 their supervisor, 3 the board
  sentTo String
  sentAt DateTime @default(now())

  @@unique([key, level])
}

/**
 * ---------------- Data readiness (Building Data Management Center) ----------------
 * New tables carry buildingId so a second building can be added without a data migration.
 */

/// Permits, certificates, insurance and other documents the building must keep valid.
model ComplianceItem {
  id              String    @id @default(cuid())
  buildingId      String
  kind            String // PERMIT | CERTIFICATE | INSURANCE | PLAN | PRIVACY | OTHER
  title           String
  authority       String // issuing body, e.g. BFP, Office of the Building Official
  docNumber       String?
  issuedAt        DateTime?
  expiresAt       DateTime?
  renewal         String? // what renewal needs, in plain words
  ownerName       String? // responsible person
  mandatory       Boolean   @default(true)
  /// The default PH checklist is a starting point. A qualified person confirms each rule applies before it counts as mandatory.
  ruleConfirmedBy String?
  ruleConfirmedAt DateTime?
  documentId      String? // supporting file in Documents
  status          String    @default("PENDING") // PENDING (entered, not checked) | VERIFIED | REJECTED
  verifiedBy      String?
  verifiedAt      DateTime?
  enteredBy       String
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([buildingId, expiresAt])
}

/// A contractor's registration, permit, licence, insurance or reference, checked by someone other than who entered it.
model VendorCredential {
  id         String    @id @default(cuid())
  vendorId   String
  kind       String // SEC_DTI | MAYORS_PERMIT | BIR_2303 | PCAB | INSURANCE | SAFETY | TECH_LICENSE | REFERENCE
  number     String?
  issuer     String?
  expiresAt  DateTime?
  documentId String?
  status     String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  enteredBy  String
  verifiedBy String?
  verifiedAt DateTime?
  note       String?
  createdAt  DateTime  @default(now())

  @@index([vendorId])
}

/// One problem found by the daily data checks. Resolving needs evidence; checks reopen it if the problem comes back.
model DataIssue {
  id         String    @id @default(cuid())
  buildingId String
  checkId    String // e.g. asset-no-pm
  entityKey  String // e.g. asset:EL-GEN-1
  severity   String // P0 | P1 | P2 | P3
  title      String
  detail     String
  ownerRole  String // who must fix it
  href       String? // where to fix it
  status     String    @default("OPEN") // OPEN | RESOLVED
  firstSeen  DateTime  @default(now())
  lastSeen   DateTime  @default(now())
  notifiedAt DateTime?
  resolvedAt DateTime?
  resolvedBy String?
  evidence   String?

  @@unique([buildingId, checkId, entityKey])
  @@index([buildingId, status, severity])
}

/// The client's sign-off on a readiness register row: owner confirmed and data approved for operational use.
model ReadinessSignoff {
  id         String   @id @default(cuid())
  buildingId String
  reqId      String
  ownerName  String
  approvedBy String
  approvedAt DateTime @default(now())
  note       String?

  @@unique([buildingId, reqId])
}

/// Weekly random re-check of finished work. The app draws the sample, so no one picks which jobs get checked.
model SpotAudit {
  id        String    @id @default(cuid())
  kind      String // WO | ROUND | RECEIPT
  refId     String
  label     String // e.g. "WO-123 Leaking faucet (1202B)"
  href      String
  person    String // whose entry is being re-checked
  weekOf    String // Manila date (YYYY-MM-DD) of the Monday the sample was drawn for
  pickedAt  DateTime  @default(now())
  dueAt     DateTime
  checkedAt DateTime?
  checkedBy String?
  result    String? // PASS | ISSUE
  note      String?
  photo     String? // optional photo taken during the re-check

  @@unique([kind, refId])
  @@index([weekOf])
}

/// An entry the app thinks a person should look at: reused photo, copy-pasted note, or many entries made at once.
/// A flag is a prompt to check, never proof. A manager (not the person flagged) clears or confirms it.
model EntryFlag {
  id          String    @id @default(cuid())
  key         String    @unique // stable id so a cleared flag is never raised again
  kind        String // SAME_PHOTO | SIMILAR_PHOTO | AFTER_LIKE_BEFORE | COPIED_NOTE | BATCHED | FAST_ROUND
  person      String
  refs        String[] // e.g. ["WO-12", "WO-40"]
  href        String
  title       String
  detail      String
  severity    Int // 1 worth a look, 2 likely a problem
  aiNote      String?
  explanation String? // the staff member's side, in their words
  status      String    @default("OPEN") // OPEN | CLEARED | CONFIRMED
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([person])
}
