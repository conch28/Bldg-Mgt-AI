// Building Mgt AI - data model
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  BOARD
  MANAGER
  ADMIN
}

enum WOStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  ESCALATED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum BillStatus {
  UNPAID
  PARTIAL
  PAID
}

model Building {
  id        String   @id @default(cuid())
  name      String
  city      String
  duesRate  Decimal  @db.Decimal(10, 2) // PHP per sqm per month
  units     Unit[]
  users     User[]
  createdAt DateTime @default(now())
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  phone        String?
  passwordHash String
  role         Role          @default(OWNER)
  active       Boolean       @default(true)
  buildingId   String
  building     Building      @relation(fields: [buildingId], references: [id])
  units        Unit[]        @relation("UnitOwner")
  workOrders   WorkOrder[]   @relation("WOReporter")
  chat         ChatMessage[]
  bookings     Booking[]
  audit        AuditLog[]
  createdAt    DateTime      @default(now())
}

model Unit {
  id         String      @id @default(cuid())
  code       String // e.g. 12B
  floor      Int
  sqm        Decimal     @db.Decimal(8, 2)
  buildingId String
  building   Building    @relation(fields: [buildingId], references: [id])
  ownerId    String?
  owner      User?       @relation("UnitOwner", fields: [ownerId], references: [id])
  ownerName  String? // for units whose owner has no login yet
  bills      Bill[]
  workOrders WorkOrder[]
  bookings   Booking[]

  @@unique([buildingId, code])
}

model WorkOrder {
  id          String      @id @default(cuid())
  number      Int         @unique @default(autoincrement())
  unitId      String?
  unit        Unit?       @relation(fields: [unitId], references: [id])
  location    String // unit code or common area
  title       String
  description String?
  category    String
  priority    Priority    @default(MEDIUM)
  status      WOStatus    @default(NEW)
  slaHours    Int
  assignee    String?
  source      String      @default("Portal")
  reporterId  String?
  reporter    User?       @relation("WOReporter", fields: [reporterId], references: [id])
  createdAt   DateTime    @default(now())
  closedAt    DateTime?
  rating      Int?
  events      WOEvent[]

  @@index([status])
}

model WOEvent {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  note        String
  author      String
  createdAt   DateTime  @default(now())
}

model Bill {
  id         String     @id @default(cuid())
  unitId     String
  unit       Unit       @relation(fields: [unitId], references: [id])
  period     String // YYYY-MM
  amount     Decimal    @db.Decimal(12, 2)
  paid       Decimal    @default(0) @db.Decimal(12, 2)
  dueDate    DateTime
  status     BillStatus @default(UNPAID)
  payments   Payment[]
  reminders  Reminder[]
  createdAt  DateTime   @default(now())

  @@unique([unitId, period])
  @@index([period, status])
}

model Payment {
  id        String   @id @default(cuid())
  billId    String
  bill      Bill     @relation(fields: [billId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  method    String // GCash, Maya, Bank, Cash, Card
  reference String
  createdAt DateTime @default(now())
}

model Reminder {
  id        String   @id @default(cuid())
  billId    String
  bill      Bill     @relation(fields: [billId], references: [id])
  channel   String // Viber, SMS, Email
  tone      String
  message   String
  sentBy    String
  sentAt    DateTime @default(now())
}

model BudgetLine {
  id       String  @id @default(cuid())
  period   String // YYYY-MM
  category String
  vendor   String
  budget   Decimal @db.Decimal(12, 2)
  actual   Decimal @db.Decimal(12, 2)
  note     String?

  @@unique([period, category])
}

model Report {
  id        String   @id @default(cuid())
  period    String
  content   String
  model     String
  createdBy String
  createdAt DateTime @default(now())
}

model Service {
  id        String    @id @default(cuid())
  name      String
  detail    String
  price     Decimal   @db.Decimal(10, 2)
  unitLabel String
  vendor    String
  active    Boolean   @default(true)
  bookings  Booking[]
}

model Booking {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  slot      DateTime
  qty       Int      @default(1)
  total     Decimal  @db.Decimal(10, 2)
  payMethod String
  status    String   @default("CONFIRMED")
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  detail    String?
  createdAt DateTime @default(now())
}
