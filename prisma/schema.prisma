// Building Mgt AI - data model
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  BOARD
  MANAGER
  ADMIN
  GUARD
}

enum WOStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  ESCALATED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum BillStatus {
  UNPAID
  PARTIAL
  PAID
}

model Building {
  id        String   @id @default(cuid())
  name      String
  city      String
  duesRate  Decimal  @db.Decimal(10, 2) // PHP per sqm per month
  units     Unit[]
  users     User[]
  createdAt DateTime @default(now())
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  phone        String?
  passwordHash String
  role         Role          @default(OWNER)
  active       Boolean       @default(true)
  buildingId   String
  building     Building      @relation(fields: [buildingId], references: [id])
  units        Unit[]        @relation("UnitOwner")
  workOrders   WorkOrder[]   @relation("WOReporter")
  chat         ChatMessage[]
  bookings     Booking[]
  audit        AuditLog[]
  language     String        @default("EN") // EN | TL (Taglish)
  notifySms    Boolean       @default(true)
  notifyEmail  Boolean       @default(true)
  notifyMessenger Boolean    @default(false)
  messengerPsid String?      // Page-scoped ID, set when the owner links Messenger
  deliveries   Delivery[]
  passes       Pass[]
  amenityBookings AmenityBooking[]
  votes        Vote[]
  createdAt    DateTime      @default(now())
}

model Unit {
  id         String      @id @default(cuid())
  code       String // e.g. 12B
  floor      Int
  sqm        Decimal     @db.Decimal(8, 2)
  buildingId String
  building   Building    @relation(fields: [buildingId], references: [id])
  ownerId    String?
  owner      User?       @relation("UnitOwner", fields: [ownerId], references: [id])
  ownerName  String? // for units whose owner has no login yet
  bills      Bill[]
  workOrders WorkOrder[]
  bookings   Booking[]
  passes     Pass[]
  amenityBookings AmenityBooking[]
  votes      Vote[]

  @@unique([buildingId, code])
}

model WorkOrder {
  id          String      @id @default(cuid())
  number      Int         @unique @default(autoincrement())
  unitId      String?
  unit        Unit?       @relation(fields: [unitId], references: [id])
  location    String // unit code or common area
  title       String
  description String?
  category    String
  priority    Priority    @default(MEDIUM)
  status      WOStatus    @default(NEW)
  slaHours    Int
  assignee    String?
  source      String      @default("Portal")
  reporterId  String?
  reporter    User?       @relation("WOReporter", fields: [reporterId], references: [id])
  createdAt   DateTime    @default(now())
  closedAt    DateTime?
  rating      Int?
  events      WOEvent[]

  @@index([status])
}

model WOEvent {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  note        String
  author      String
  createdAt   DateTime  @default(now())
}

model Bill {
  id         String     @id @default(cuid())
  unitId     String
  unit       Unit       @relation(fields: [unitId], references: [id])
  period     String // YYYY-MM
  amount     Decimal    @db.Decimal(12, 2)
  paid       Decimal    @default(0) @db.Decimal(12, 2)
  dueDate    DateTime
  status     BillStatus @default(UNPAID)
  payments   Payment[]
  reminders  Reminder[]
  createdAt  DateTime   @default(now())

  @@unique([unitId, period])
  @@index([period, status])
}

model Payment {
  id        String   @id @default(cuid())
  billId    String
  bill      Bill     @relation(fields: [billId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  method    String // GCash, Maya, Bank, Cash, Card
  reference String
  createdAt DateTime @default(now())
}

model Reminder {
  id        String   @id @default(cuid())
  billId    String
  bill      Bill     @relation(fields: [billId], references: [id])
  channel   String // Viber, SMS, Email
  tone      String
  message   String
  sentBy    String
  sentAt    DateTime @default(now())
}

model BudgetLine {
  id       String  @id @default(cuid())
  period   String // YYYY-MM
  category String
  vendor   String
  budget   Decimal @db.Decimal(12, 2)
  actual   Decimal @db.Decimal(12, 2)
  note     String?

  @@unique([period, category])
}

model Report {
  id        String   @id @default(cuid())
  period    String
  content   String
  model     String
  createdBy String
  createdAt DateTime @default(now())
}

model Service {
  id        String    @id @default(cuid())
  name      String
  detail    String
  price     Decimal   @db.Decimal(10, 2)
  unitLabel String
  vendor    String
  active    Boolean   @default(true)
  bookings  Booking[]
}

model Booking {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  slot      DateTime
  qty       Int      @default(1)
  total     Decimal  @db.Decimal(10, 2)
  payMethod String
  status    String   @default("CONFIRMED")
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  detail    String?
  createdAt DateTime @default(now())
}

/* ---------------- Resident communications ---------------- */

enum AnnStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

model Announcement {
  id          String     @id @default(cuid())
  kind        String // URGENT | ROUTINE | REMINDER | TICKET
  category    String // e.g. Water interruption, Newsletter, Meeting notice
  title       String
  bodyEn      String
  bodyTl      String? // Taglish version
  smsEn       String? // short SMS version (<= 300 chars)
  smsTl       String?
  audience    String     @default("ALL") // ALL | FLOORS:12,13 | UNITS:12B,9C | OVERDUE | BOARD
  channels    String[]   @default(["APP", "SMS", "EMAIL"]) // APP SMS EMAIL MESSENGER
  status      AnnStatus  @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  aiDrafted   Boolean    @default(false)
  createdBy   String
  approvedBy  String?
  createdAt   DateTime   @default(now())
  deliveries  Delivery[]

  @@index([status, scheduledAt])
}

model Delivery {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  unitCode       String?
  channel        String // APP SMS EMAIL MESSENGER
  to             String?
  status         String // SENT | LOGGED | FAILED | READ
  info           String?
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([userId, channel])
}

/* ---------------- Amenities ---------------- */

model Amenity {
  id        String           @id @default(cuid())
  name      String
  detail    String
  capacity  Int
  fee       Decimal          @default(0) @db.Decimal(10, 2)
  openHour  Int // 0-23, Manila time
  closeHour Int
  slotHours Int              @default(1)
  closedDow Int? // 0=Sun..6=Sat
  rules     String?
  bookings  AmenityBooking[]
}

model AmenityBooking {
  id        String   @id @default(cuid())
  amenityId String
  amenity   Amenity  @relation(fields: [amenityId], references: [id])
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  start     DateTime
  end       DateTime
  guests    Int      @default(0)
  status    String   @default("CONFIRMED") // CONFIRMED | CANCELLED
  createdAt DateTime @default(now())

  @@index([amenityId, start])
}

/* ---------------- Visitor and delivery passes ---------------- */

model Pass {
  id         String    @id @default(cuid())
  code       String    @unique // 6-char code shown to the guard
  kind       String // GUEST | DELIVERY | CONTRACTOR | MOVE
  name       String // guest or courier name
  plate      String?
  unitId     String
  unit       Unit      @relation(fields: [unitId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  validFrom  DateTime
  validTo    DateTime
  checkedIn  DateTime?
  checkedOut DateTime?
  note       String?
  createdAt  DateTime  @default(now())
}

/* ---------------- Documents ---------------- */

model Document {
  id         String   @id @default(cuid())
  title      String
  category   String // Governance | Financial | Minutes | Contracts | Notices | Forms
  visibility String   @default("OWNERS") // OWNERS | BOARD
  fileName   String
  mime       String
  size       Int
  data       Bytes
  uploadedBy String
  createdAt  DateTime @default(now())
}

/* ---------------- Voting and polls ---------------- */

model Poll {
  id          String       @id @default(cuid())
  question    String
  detail      String?
  kind        String       @default("POLL") // POLL (one vote per owner) | RESOLUTION (one vote per unit, weighted by sqm)
  closesAt    DateTime
  createdBy   String
  createdAt   DateTime     @default(now())
  options     PollOption[]
  votes       Vote[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label  String
  votes  Vote[]
}

model Vote {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit       @relation(fields: [unitId], references: [id])
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  weight    Decimal    @db.Decimal(10, 2)
  createdAt DateTime   @default(now())

  @@unique([pollId, unitId])
}

/* ---------------- Vendors and contracts ---------------- */

model Vendor {
  id              String    @id @default(cuid())
  name            String
  service         String
  contact         String?
  phone           String?
  email           String?
  monthlyValue    Decimal   @default(0) @db.Decimal(12, 2)
  contractStart   DateTime?
  contractEnd     DateTime?
  insuranceExpiry DateTime?
  rating          Decimal?  @db.Decimal(3, 1)
  notes           String?
  active          Boolean   @default(true)
}

/* ---------------- Preventive maintenance ---------------- */

model PMTask {
  id            String    @id @default(cuid())
  asset         String // e.g. Fire pump, Elevator 1-4, Genset
  task          String
  frequencyDays Int
  lastDone      DateTime?
  nextDue       DateTime
  assignee      String?
  vendor        String?
  compliance    Boolean   @default(false) // required by BFP/DOLE/LGU
  lastWorkOrder Int?
}
